[Unit]
Description=Pear Passwords: sync the iCloud Keychain
# Needs the anisette identity up, or the token refresh cannot be attempted at all.
Wants=pear-passwords-anisette.service
After=pear-passwords-anisette.service network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/pear-passwords/venv/bin/icp sync
# To the journal on purpose: a sync that fails silently stays broken for weeks.
StandardOutput=journal
StandardError=journal
LimitCORE=0
NoNewPrivileges=true
