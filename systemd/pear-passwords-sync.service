[Unit]
Description=Pear Passwords: sync your passwords on iCloud
# Needs the anisette identity up, or the token refresh cannot be attempted at all.
Wants=pear-passwords-anisette.service
After=pear-passwords-anisette.service network-online.target

[Service]
# --no-prompt: this unit runs with the desktop session in its environment, so without it the
# passphrase prompt finds zenity and puts a modal password box on screen every two hours. The
# key lives only in the agent's memory; when it is not there, the right answer is to skip and
# sync at the next unlock, not to interrupt whatever the person is doing.
Type=oneshot
ExecStart=%h/.local/share/pear-passwords/venv/bin/icp sync --no-prompt
# To the journal on purpose: a sync that fails silently stays broken for weeks.
StandardOutput=journal
StandardError=journal
LimitCORE=0
NoNewPrivileges=true
