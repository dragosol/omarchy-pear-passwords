[Unit]
Description=Pear Passwords: local anisette server for Apple sign-in
After=network-online.target
# A start that fails before the DLL is in the volume downloads iCloud for Windows (337 MB) again;
# a lasting failure (a changed Store package, a digest mismatch) stops after a few tries.
StartLimitIntervalSec=1h
StartLimitBurst=6

[Service]
Type=simple
# Apple's Windows ADI (CoreADI64.dll from iCloud for Windows), run under Wine by Pear's loader.
# The image is built on this machine by anisette/build.sh from one pinned apple-crates commit
# plus Pear's recipe (anisette/recipe-id.sh), and the tag below names both. The DLL itself is
# fetched from the Microsoft Store on first start and checked against anisette/coreadi.sha256.
# docs/anisette-provenance.md records the whole chain.
#
# The volume holds the Wine prefix, which is the machine Apple binds 2FA trust to: CoreADI keeps
# its provisioning there. CoreADI also derives the device id from the network adapter's MAC
# address and the computer name, which a container would otherwise get fresh on every start, so
# both are fixed here: the MAC to one locally administered address, the name to this machine's
# id (%m), so two machines never present the same device. 1.x/2.0's Android identity stays in
# the old icp-anisette volume, unused.
ExecStartPre=-/usr/bin/podman rm -f pear-passwords-anisette
ExecStart=/usr/bin/podman run --rm --name pear-passwords-anisette \
    --hostname %m \
    --network pasta:--ns-mac-addr,02:50:65:61:72:01 \
    -v pear-passwords-anisette:/home/pear/data \
    -p 127.0.0.1:6969:6969 \
    localhost/pear-passwords-anisette:b6e2ac2e5eb971fed221e298a043d6a61402645b-45e02ff03d90
ExecStop=/usr/bin/podman stop -t 10 pear-passwords-anisette
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
