[Unit]
Description=Pear Passwords: local anisette server for Apple sign-in
After=network-online.target

[Service]
Type=simple
# The ADI provisioning (adi.pb + device.json) is the machine identity Apple binds 2FA trust
# to. Kept in a named volume so it survives restarts: without it every restart minted a new
# identity and Apple asked for a verification code again.
#
# The image is pinned by digest: a silent :latest re-pull could change the identity handling
# underneath a trust relationship meant to last.
ExecStartPre=-/usr/bin/podman rm -f pear-passwords-anisette
# The server can write adi.pb with a mode its own user cannot read (seen as 1127), then
# silently re-provisions and Apple treats this as a new Mac. Normalise it before every start.
ExecStartPre=-/usr/bin/podman unshare chmod 0600 %h/.local/share/containers/storage/volumes/icp-anisette/_data/adi.pb
ExecStart=/usr/bin/podman run --rm --name pear-passwords-anisette \
    -v icp-anisette:/home/Alcoholic/.config/anisette-v3 \
    -p 127.0.0.1:6969:6969 \
    docker.io/dadoum/anisette-v3-server@sha256:0391510966a49dfc852a1d6f6d111b2d51ca35d4988b416386b47cdc24263531
ExecStop=/usr/bin/podman stop -t 10 pear-passwords-anisette
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
