[Unit]
Description=Pear Passwords: keep your iCloud Passwords fresh

[Timer]
# Every two hours, catching up after sleep (Persistent= needs OnCalendar=).
OnCalendar=0/2:00
Persistent=true
AccuracySec=1min
RandomizedDelaySec=30s
# And one shortly after login.
OnStartupSec=2min

[Install]
WantedBy=timers.target
