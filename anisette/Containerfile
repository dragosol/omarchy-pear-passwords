# Pear Passwords: anisette server on Apple's Windows ADI, built from pinned source.
#
# Since October 2026 Apple's GrandSlam refuses anisette made by Apple's Android ADI (the
# library anisette-v3-server loads): Apple ID sign-in is not served to Android clients, and a
# client that claims another platform gets -80045. Apple's Windows ADI, CoreADI64.dll from
# iCloud for Windows, is accepted when the client says it is iCloud for Windows. So this image
# runs that DLL under Wine, through a small loader (loader/) built on Dadoum's apple-crates.
#
# Apple's CoreADI64.dll is NOT in this image. entrypoint.sh fetches it on first start from the
# Microsoft Store (fetch-coreadi.py), refuses anything that does not match coreadi.sha256, and
# keeps it in the volume. See docs/anisette-provenance.md.

# rust:1-slim-trixie (Rust 1.99.1), linux/amd64, resolved 2026-11-12
ARG RUST_BUILDER=docker.io/library/rust:1-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7
# fedora-minimal:44, linux/amd64, resolved 2026-11-12. Fedora because its Wine (11.x) can build
# the TLS client the loader provisions with; Debian trixie's Wine 10 fails inside crypt32 with
# "Invalid parameter" before any connection is made.
ARG RUNTIME=registry.fedoraproject.org/fedora-minimal:44@sha256:964ca942f6e28c5229eb81078f2d2e3ee0aa644871fb9b054507d26c1e569a77

# apple-crates (MPL, per its author), the one revision the loader is built against. Full
# 40-character commit SHA only: a branch or a tag could move under the same name.
ARG APPLE_CRATES_REV=b6e2ac2e5eb971fed221e298a043d6a61402645b
ARG APPLE_CRATES_REPO=https://tangled.org/dadoum.zone/apple-crates
# A short hash of Pear's own files in this directory (recipe-id.sh), recorded as a label and in
# the image tag, so a changed loader or gate is never mistaken for an image already built.
ARG PEAR_RECIPE=unset

FROM ${RUST_BUILDER} AS builder
ARG APPLE_CRATES_REV
ARG APPLE_CRATES_REPO

RUN apt-get update \
 && apt-get install --no-install-recommends -y ca-certificates git gcc-mingw-w64-x86-64 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* \
 && rustup target add x86_64-pc-windows-gnu

WORKDIR /src

# Fetch exactly the pinned commit and refuse to build anything else. The length check rejects
# an abbreviated SHA; the rev-parse check rejects a repository that resolved it to another commit.
RUN test "${#APPLE_CRATES_REV}" -eq 40 \
 && git init -q apple-crates \
 && git -C apple-crates remote add origin "${APPLE_CRATES_REPO}" \
 && git -C apple-crates fetch -q --depth 1 origin "${APPLE_CRATES_REV}" \
 && git -C apple-crates -c advice.detachedHead=false checkout -q FETCH_HEAD \
 && test "$(git -C apple-crates rev-parse HEAD)" = "${APPLE_CRATES_REV}" \
 && echo "building against apple-crates ${APPLE_CRATES_REV}"

# Every registry crate is pinned, with its checksum, by loader/Cargo.lock; --locked refuses to
# build if resolving would change it.
COPY loader/ /src/loader/
RUN cd /src/loader \
 && cargo build --locked --release --target x86_64-pc-windows-gnu \
 && cp target/x86_64-pc-windows-gnu/release/pear-coreadi.exe /src/pear-coreadi.exe

FROM ${RUNTIME}
ARG APPLE_CRATES_REV
ARG RUNTIME
ARG PEAR_RECIPE

# wine-core runs the loader (64-bit only), and wine-common has the files Wine's first start
# copies into the prefix (without it that step retries a missing file forever); python3 and
# ca-certificates are what fetch-coreadi.py downloads and checks the DLL with. Nothing else: no
# wine-mono or Gecko, which the loader never uses, and no weak dependencies.
RUN microdnf install -y --setopt=install_weak_deps=0 wine-core wine-common python3 ca-certificates shadow-utils \
 && microdnf clean all

RUN useradd -m -s /usr/sbin/nologin pear \
 && mkdir -p /opt/pear /home/pear/data \
 && chown pear:pear /home/pear/data

COPY --from=builder /src/pear-coreadi.exe /opt/pear/pear-coreadi.exe
# The gate, the digests it enforces and the one CA the Store fetch trusts travel in the image,
# root-owned and read-only, so the server's own user cannot rewrite what checks it.
COPY entrypoint.sh fetch-coreadi.py coreadi.sha256 microsoft-root-ca-2011.pem /opt/pear/
RUN chown -R root:root /opt/pear \
 && chmod 0555 /opt/pear/entrypoint.sh /opt/pear/fetch-coreadi.py /opt/pear/pear-coreadi.exe \
 && chmod 0444 /opt/pear/coreadi.sha256 /opt/pear/microsoft-root-ca-2011.pem

LABEL org.opencontainers.image.title="Pear Passwords anisette (Windows ADI)" \
      org.opencontainers.image.description="Anisette server for Apple sign-in for the Pear Passwords Omarchy plugin: Apple's CoreADI64.dll from iCloud for Windows, run under Wine through a loader built on apple-crates. The DLL is downloaded from the Microsoft Store at first start, not baked in, and is checked against coreadi.sha256 before it is loaded." \
      org.opencontainers.image.source="https://github.com/dragosol/omarchy-pear-passwords" \
      io.github.dragosol.pear-passwords.apple-crates.source="https://tangled.org/dadoum.zone/apple-crates" \
      io.github.dragosol.pear-passwords.apple-crates.revision="${APPLE_CRATES_REV}" \
      io.github.dragosol.pear-passwords.recipe="${PEAR_RECIPE}" \
      org.opencontainers.image.licenses="MIT AND MPL-2.0" \
      org.opencontainers.image.base.name="${RUNTIME}" \
      org.opencontainers.image.documentation="https://github.com/dragosol/omarchy-pear-passwords/blob/main/docs/anisette-provenance.md"

USER pear
WORKDIR /home/pear
ENV WINEPREFIX=/home/pear/data/prefix \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    WINEDEBUG=-all
EXPOSE 6969
ENTRYPOINT [ "/opt/pear/entrypoint.sh" ]
