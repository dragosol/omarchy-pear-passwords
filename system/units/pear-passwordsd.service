# Pear Passwords 2: pear-passwordsd, the only process that ever holds key material.
#
# It runs as its own system user, keeps per-user state in /var/lib/pear-passwords/u<uid>/
# (0700, unreadable by the users themselves), and seals its keys with systemd-creds under that
# user. Started by pear-passwordsd.socket; exits after a minute with nothing connected and
# nothing unlocked.

[Unit]
Description=Pear Passwords key holder
Documentation=https://github.com/dragosol/omarchy-pear-passwords/blob/main/docs/protocol.md
Requires=pear-passwordsd.socket
After=pear-passwordsd.socket dbus.service systemd-logind.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/lib/pear-passwords/libexec/pear-passwordsd
User=pear-passwords
Group=pear-passwords
SupplementaryGroups=
StateDirectory=pear-passwords
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
# Gate G2 fallback: polkit subjects as {pid, start-time, uid} instead of a pidfd. Only if the
# VM test shows polkit refusing pidfd subjects.
#Environment=PEAR_POLKIT_SUBJECT=pid-start-time

# Privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem and devices
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
RemoveIPC=yes
# The daemon reads /proc/<pid>/{status,stat} of its peers, so other users' processes must
# stay visible: ProtectProc=invisible would hide them.
ProtectProc=default

# Kernel and namespaces. PrivateUsers is not set: it would map every peer uid to nobody.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Gate G8: cffi (PyNaCl), cryptography and srp under W^X. If the VM test fails, this line is
# removed and docs/security.md says why.
MemoryDenyWriteExecute=yes
KeyringMode=private

# Network and system calls: AF_UNIX for the socket, D-Bus and systemd-creds; AF_INET(6) for
# iCloud and the local anisette server.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM

# Limits and lifecycle. No MemoryMax: a v1 migration runs Argon2id at 256 MiB.
LimitCORE=0
LimitMEMLOCK=16M
Restart=on-failure
WatchdogSec=60
